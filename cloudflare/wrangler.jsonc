{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "felix-investment-dashboard",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "triggers": {
    "crons": [
      "*/5 14-19 * * 1-5",
      "0 20 * * 1-5"
    ]
  },
  "vars": {
    "GITHUB_OWNER": "felixalbertjara",
    "GITHUB_REPO": "felix-investment-dashboard",
    "GITHUB_BRANCH": "main"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "felix-dashboard-db",
      "database_id": "3776a5e0-ab33-4856-af98-054f1ccc3232",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SNAPSHOTS",
      "id": "729e69a2346b4017bce788b02cd60fb7"
    }
  ]
}
